{
    "name": "Stock",
    "uid": "com_unic8_elan_stock",
    "description": "Stock plugin",
    "author": "unic8 Studios",
    "version": "0.1.0",
    "process": {
        "multiple": true,
        "priority": 0
    },
    "permissions": [
    ],
    "features": [
    ],
    "inputs": [
        {"name": "symbol", "type": "String", "value": ""},
        {"name": "amount", "type": "Number", "value": 1},
        {"name": "period", "type": "String", "value": "day", "presets": [{"Day": "day"}, {"Week": "week"}, {"Month": "month"}, {"Year": "year"}]},
        {"name": "duration", "type": "Number", "value": 10},
        {"name": "frequency", "type": "String", "value": "m", "presets": [{"Minute": "m"}, {"Hour": "h"}, {"Day": "d"}, {"Week": "wk"}, {"Month": "mo"}]}
    ],
    "outputs": [
        {"name": "open", "type": "Number", "value": 0},
        {"name": "high", "type": "Number", "value": 0},
        {"name": "low", "type": "Number", "value": 0},
        {"name": "close", "type": "Number", "value": 0},
        {"name": "volume", "type": "Number", "value": 0}
    ],
    "files": [
    ]
}